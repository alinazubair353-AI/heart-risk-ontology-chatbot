    <hasSex rdf:datatype="http://www.w3.org/2001/XMLSchema#string">male</hasSex>
    <hasChestPain rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasChestPain>
  </owl:NamedIndividual>

</rdf:RDF>
