<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/heart-risk#" xml:base="http://example.org/heart-risk"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="http://example.org/heart-risk">
    <rdfs:label>Heart Risk Ontology</rdfs:label>
    <rdfs:comment>Educational ontology of cardiovascular risk factors and published cut-offs. Not a medical device and not clinically validated.</rdfs:comment>
  </owl:Ontology>

  <owl:AnnotationProperty rdf:about="#hasSource"/>
  <owl:AnnotationProperty rdf:about="#hasExplanation"/>
  <owl:AnnotationProperty rdf:about="#hasAdvice"/>
  <owl:AnnotationProperty rdf:about="#hasSeverity"/>
  <owl:AnnotationProperty rdf:about="#hasCategory"/>
  <owl:AnnotationProperty rdf:about="#hasSynonym"/>
  <owl:AnnotationProperty rdf:about="#hasUnit"/>
  <owl:AnnotationProperty rdf:about="#hasMin"/>
  <owl:AnnotationProperty rdf:about="#hasMax"/>
  <owl:AnnotationProperty rdf:about="#hasMmolFactor"/>
  <owl:AnnotationProperty rdf:about="#hasMmolBelow"/>
  <owl:AnnotationProperty rdf:about="#relatesTo"/>

  <owl:Class rdf:about="#Patient"><rdfs:label>Patient</rdfs:label></owl:Class>
  <owl:Class rdf:about="#Concept"><rdfs:label>Concept</rdfs:label></owl:Class>

  <owl:DatatypeProperty rdf:about="#hasAge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>Age</rdfs:label>
    <hasUnit>years</hasUnit>
    <hasMin>1</hasMin>
    <hasMax>120</hasMax>
    <hasSynonym>age</hasSynonym>
    <hasSynonym>aged</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasSex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Sex</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasTotalCholesterol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>Total cholesterol</rdfs:label>
    <hasUnit>mg/dL</hasUnit>
    <hasMin>50</hasMin>
    <hasMax>800</hasMax>
    <hasMmolFactor>38.67</hasMmolFactor>
    <hasMmolBelow>20</hasMmolBelow>
    <hasSynonym>total cholesterol</hasSynonym>
    <hasSynonym>total chol</hasSynonym>
    <hasSynonym>cholesterol</hasSynonym>
    <hasSynonym>tc</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasLDL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>LDL cholesterol</rdfs:label>
    <hasUnit>mg/dL</hasUnit>
    <hasMin>10</hasMin>
    <hasMax>600</hasMax>
    <hasMmolFactor>38.67</hasMmolFactor>
    <hasMmolBelow>20</hasMmolBelow>
    <hasSynonym>ldl</hasSynonym>
    <hasSynonym>ldl cholesterol</hasSynonym>
    <hasSynonym>ldl-cholesterol</hasSynonym>
    <hasSynonym>ldl-c</hasSynonym>
    <hasSynonym>bad cholesterol</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasHDL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>HDL cholesterol</rdfs:label>
    <hasUnit>mg/dL</hasUnit>
    <hasMin>5</hasMin>
    <hasMax>150</hasMax>
    <hasMmolFactor>38.67</hasMmolFactor>
    <hasMmolBelow>8</hasMmolBelow>
    <hasSynonym>hdl</hasSynonym>
    <hasSynonym>hdl cholesterol</hasSynonym>
    <hasSynonym>hdl-cholesterol</hasSynonym>
    <hasSynonym>hdl-c</hasSynonym>
    <hasSynonym>good cholesterol</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasTriglycerides">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>Triglycerides</rdfs:label>
    <hasUnit>mg/dL</hasUnit>
    <hasMin>20</hasMin>
    <hasMax>5000</hasMax>
    <hasMmolFactor>88.57</hasMmolFactor>
    <hasMmolBelow>25</hasMmolBelow>
    <hasSynonym>triglycerides</hasSynonym>
    <hasSynonym>triglyceride</hasSynonym>
    <hasSynonym>trigs</hasSynonym>
    <hasSynonym>tg</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasSystolicBP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>Systolic blood pressure</rdfs:label>
    <hasUnit>mmHg</hasUnit>
    <hasMin>60</hasMin>
    <hasMax>300</hasMax>
    <hasSynonym>systolic</hasSynonym>
    <hasSynonym>systolic bp</hasSynonym>
    <hasSynonym>systolic blood pressure</hasSynonym>
    <hasSynonym>sbp</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasDiastolicBP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>Diastolic blood pressure</rdfs:label>
    <hasUnit>mmHg</hasUnit>
    <hasMin>30</hasMin>
    <hasMax>200</hasMax>
    <hasSynonym>diastolic</hasSynonym>
    <hasSynonym>diastolic bp</hasSynonym>
    <hasSynonym>diastolic blood pressure</hasSynonym>
    <hasSynonym>dbp</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasFastingGlucose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>Fasting glucose</rdfs:label>
    <hasUnit>mg/dL</hasUnit>
    <hasMin>30</hasMin>
    <hasMax>800</hasMax>
    <hasMmolFactor>18.016</hasMmolFactor>
    <hasMmolBelow>35</hasMmolBelow>
    <hasSynonym>fasting glucose</hasSynonym>
    <hasSynonym>fasting blood sugar</hasSynonym>
    <hasSynonym>fasting blood glucose</hasSynonym>
    <hasSynonym>fasting sugar</hasSynonym>
    <hasSynonym>fbs</hasSynonym>
    <hasSynonym>fbg</hasSynonym>
    <hasSynonym>blood glucose</hasSynonym>
    <hasSynonym>blood sugar</hasSynonym>
    <hasSynonym>glucose</hasSynonym>
    <hasSynonym>sugar</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasHbA1c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>HbA1c</rdfs:label>
    <hasUnit>%</hasUnit>
    <hasMin>3</hasMin>
    <hasMax>20</hasMax>
    <hasSynonym>hba1c</hasSynonym>
    <hasSynonym>hb a1c</hasSynonym>
    <hasSynonym>a1c</hasSynonym>
    <hasSynonym>glycated hemoglobin</hasSynonym>
    <hasSynonym>glycosylated hemoglobin</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasBMI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>BMI</rdfs:label>
    <hasUnit>kg/m2</hasUnit>
    <hasMin>10</hasMin>
    <hasMax>80</hasMax>
    <hasSynonym>bmi</hasSynonym>
    <hasSynonym>body mass index</hasSynonym>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#isSmoker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>Current smoker</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasFamilyHistoryPrematureCVD">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>Family history of premature heart disease</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasChestPain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>Chest pain (reported now)</rdfs:label>
  </owl:DatatypeProperty>

  <owl:Class rdf:about="#Topic_LDL">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>LDL cholesterol</rdfs:label>
    <hasExplanation>LDL ('bad') cholesterol carries cholesterol to artery walls. Higher levels promote plaque build-up, which is why LDL is the main target of cholesterol treatment.</hasExplanation>
    <hasSource>NCEP ATP III; 2018 AHA/ACC Cholesterol Guideline</hasSource>
    <relatesTo>hasLDL</relatesTo>
    <hasSynonym>ldl</hasSynonym>
    <hasSynonym>ldl cholesterol</hasSynonym>
    <hasSynonym>ldl-c</hasSynonym>
    <hasSynonym>bad cholesterol</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_HDL">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>HDL cholesterol</rdfs:label>
    <hasExplanation>HDL ('good') cholesterol helps remove cholesterol from the blood. Low HDL is linked to higher cardiovascular risk. The low cut-off differs by sex.</hasExplanation>
    <hasSource>NCEP ATP III; AHA/NHLBI metabolic syndrome statement (2005)</hasSource>
    <relatesTo>hasHDL</relatesTo>
    <hasSynonym>hdl</hasSynonym>
    <hasSynonym>hdl cholesterol</hasSynonym>
    <hasSynonym>hdl-c</hasSynonym>
    <hasSynonym>good cholesterol</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_TotalCholesterol">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Total cholesterol</rdfs:label>
    <hasExplanation>Total cholesterol is the sum of cholesterol in all lipoprotein types (mainly LDL + HDL + a share of triglycerides). It is a rough screening number; LDL and HDL are more informative.</hasExplanation>
    <hasSource>NCEP ATP III</hasSource>
    <relatesTo>hasTotalCholesterol</relatesTo>
    <hasSynonym>total cholesterol</hasSynonym>
    <hasSynonym>total chol</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_Triglycerides">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Triglycerides</rdfs:label>
    <hasExplanation>Triglycerides are a blood fat that rises with excess calories, sugar, alcohol and insulin resistance. High levels add to cardiovascular risk; very high levels can cause pancreatitis.</hasExplanation>
    <hasSource>NCEP ATP III</hasSource>
    <relatesTo>hasTriglycerides</relatesTo>
    <hasSynonym>triglycerides</hasSynonym>
    <hasSynonym>triglyceride</hasSynonym>
    <hasSynonym>trigs</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_Cholesterol">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Cholesterol / lipid profile</rdfs:label>
    <hasExplanation>A lipid profile reports total cholesterol, LDL, HDL and triglycerides. Ask about any one of them (for example 'what is LDL?') for its thresholds.</hasExplanation>
    <hasSource>NCEP ATP III</hasSource>
    <relatesTo>hasTotalCholesterol</relatesTo>
    <relatesTo>hasLDL</relatesTo>
    <relatesTo>hasHDL</relatesTo>
    <relatesTo>hasTriglycerides</relatesTo>
    <hasSynonym>cholesterol</hasSynonym>
    <hasSynonym>lipids</hasSynonym>
    <hasSynonym>lipid profile</hasSynonym>
    <hasSynonym>lipid panel</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_BloodPressure">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Blood pressure</rdfs:label>
    <hasExplanation>Blood pressure is written as systolic/diastolic (for example 150/95 mmHg). Persistently high pressure damages arteries and raises the risk of heart attack and stroke. A diagnosis needs the average of readings on 2 or more occasions, not one reading.</hasExplanation>
    <hasSource>2017 ACC/AHA High Blood Pressure Guideline</hasSource>
    <relatesTo>hasSystolicBP</relatesTo>
    <relatesTo>hasDiastolicBP</relatesTo>
    <hasSynonym>blood pressure</hasSynonym>
    <hasSynonym>bp</hasSynonym>
    <hasSynonym>hypertension</hasSynonym>
    <hasSynonym>high blood pressure</hasSynonym>
    <hasSynonym>systolic</hasSynonym>
    <hasSynonym>diastolic</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_Glucose">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Blood glucose / diabetes</rdfs:label>
    <hasExplanation>Fasting glucose shows how well the body handles sugar. Diabetes damages blood vessels and strongly raises cardiovascular risk. Rules here assume a fasting sample.</hasExplanation>
    <hasSource>ADA Standards of Care in Diabetes</hasSource>
    <relatesTo>hasFastingGlucose</relatesTo>
    <hasSynonym>glucose</hasSynonym>
    <hasSynonym>blood sugar</hasSynonym>
    <hasSynonym>fasting glucose</hasSynonym>
    <hasSynonym>fasting blood sugar</hasSynonym>
    <hasSynonym>fbs</hasSynonym>
    <hasSynonym>sugar</hasSynonym>
    <hasSynonym>diabetes</hasSynonym>
    <hasSynonym>prediabetes</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_HbA1c">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>HbA1c</rdfs:label>
    <hasExplanation>HbA1c reflects average blood glucose over about 3 months. It does not need fasting.</hasExplanation>
    <hasSource>ADA Standards of Care in Diabetes</hasSource>
    <relatesTo>hasHbA1c</relatesTo>
    <hasSynonym>hba1c</hasSynonym>
    <hasSynonym>a1c</hasSynonym>
    <hasSynonym>glycated hemoglobin</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_BMI">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>BMI / body weight</rdfs:label>
    <hasExplanation>BMI is weight (kg) divided by height (m) squared. Higher BMI is linked to high blood pressure, diabetes and abnormal lipids.</hasExplanation>
    <hasSource>WHO BMI classification</hasSource>
    <relatesTo>hasBMI</relatesTo>
    <hasSynonym>bmi</hasSynonym>
    <hasSynonym>body mass index</hasSynonym>
    <hasSynonym>weight</hasSynonym>
    <hasSynonym>obesity</hasSynonym>
    <hasSynonym>overweight</hasSynonym>
    <hasSynonym>obese</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_Smoking">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Smoking</rdfs:label>
    <hasExplanation>Smoking damages blood vessels and raises the risk of heart attack and stroke, and it adds to the effect of other risk factors.</hasExplanation>
    <hasSource>2019 ACC/AHA Primary Prevention Guideline</hasSource>
    <relatesTo>isSmoker</relatesTo>
    <hasSynonym>smoking</hasSynonym>
    <hasSynonym>smoker</hasSynonym>
    <hasSynonym>tobacco</hasSynonym>
    <hasSynonym>cigarette</hasSynonym>
    <hasSynonym>cigarettes</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_FamilyHistory">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Family history</rdfs:label>
    <hasExplanation>Heart disease in a close relative at a young age (father or brother before 55, mother or sister before 65) raises your own risk.</hasExplanation>
    <hasSource>2019 ACC/AHA Primary Prevention Guideline</hasSource>
    <relatesTo>hasFamilyHistoryPrematureCVD</relatesTo>
    <hasSynonym>family history</hasSynonym>
    <hasSynonym>hereditary</hasSynonym>
    <hasSynonym>genetic</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_Age">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Age and sex</rdfs:label>
    <hasExplanation>Cardiovascular risk rises with age. A common rule: age 45 or older in men, 55 or older in women counts as a risk factor.</hasExplanation>
    <hasSource>NCEP ATP III</hasSource>
    <relatesTo>hasAge</relatesTo>
    <relatesTo>hasSex</relatesTo>
    <hasSynonym>age</hasSynonym>
    <hasSynonym>how old</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_ChestPain">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Chest pain</rdfs:label>
    <hasExplanation>Chest pain can be a sign of a heart attack, but many other causes exist. A chatbot cannot tell which one applies.</hasExplanation>
    <hasSource>2021 AHA/ACC Chest Pain Guideline</hasSource>
    <relatesTo>hasChestPain</relatesTo>
    <hasSynonym>chest pain</hasSynonym>
    <hasSynonym>chest tightness</hasSynonym>
    <hasSynonym>chest pressure</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Topic_CardiovascularRisk">
    <rdfs:subClassOf rdf:resource="#Concept"/>
    <rdfs:label>Cardiovascular risk</rdfs:label>
    <hasExplanation>Cardiovascular risk is the chance of heart attack, stroke or related disease. This ontology does NOT calculate a percentage risk score; it checks each risk factor against published cut-offs and flags what to discuss with a clinician.</hasExplanation>
    <hasSource>2019 ACC/AHA Primary Prevention Guideline</hasSource>
    <relatesTo>hasAge</relatesTo>
    <relatesTo>hasSex</relatesTo>
    <relatesTo>hasLDL</relatesTo>
    <relatesTo>hasHDL</relatesTo>
    <relatesTo>hasTotalCholesterol</relatesTo>
    <relatesTo>hasTriglycerides</relatesTo>
    <relatesTo>hasSystolicBP</relatesTo>
    <relatesTo>hasDiastolicBP</relatesTo>
    <relatesTo>hasFastingGlucose</relatesTo>
    <relatesTo>hasHbA1c</relatesTo>
    <relatesTo>hasBMI</relatesTo>
    <relatesTo>isSmoker</relatesTo>
    <relatesTo>hasFamilyHistoryPrematureCVD</relatesTo>
    <hasSynonym>heart disease</hasSynonym>
    <hasSynonym>cardiovascular risk</hasSynonym>
    <hasSynonym>heart risk</hasSynonym>
    <hasSynonym>cardiovascular disease</hasSynonym>
    <hasSynonym>cvd</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#BorderlineHighLDLPatient">
    <rdfs:label>Borderline-high LDL cholesterol (&gt;= 130 mg/dL)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasLDL"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">130</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>LDL of 130-159 mg/dL is classed as borderline high.</hasExplanation>
    <hasAdvice>Discuss diet, physical activity and LDL targets with a clinician; repeat the lipid test as advised.</hasAdvice>
    <hasSource>NCEP ATP III</hasSource>
    <hasSynonym>borderline ldl</hasSynonym>
    <hasSynonym>borderline high ldl</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#HighLDLPatient">
    <rdfs:label>High LDL cholesterol (&gt;= 160 mg/dL)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#BorderlineHighLDLPatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasLDL"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">160</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>LDL of 160-189 mg/dL is classed as high.</hasExplanation>
    <hasAdvice>See a clinician to discuss lifestyle changes and whether treatment is needed.</hasAdvice>
    <hasSource>NCEP ATP III</hasSource>
    <hasSynonym>high ldl</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#VeryHighLDLPatient">
    <rdfs:label>Very high LDL cholesterol (&gt;= 190 mg/dL)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#HighLDLPatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasLDL"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">190</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>LDL of 190 mg/dL or more is classed as very high and can reflect an inherited lipid disorder.</hasExplanation>
    <hasAdvice>See a clinician soon. Guidelines treat LDL &gt;= 190 mg/dL as warranting a treatment discussion regardless of other risk factors.</hasAdvice>
    <hasSource>NCEP ATP III; 2018 AHA/ACC Cholesterol Guideline</hasSource>
    <hasSynonym>very high ldl</hasSynonym>
    <hasSynonym>severe hypercholesterolemia</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#BorderlineHighTotalCholesterolPatient">
    <rdfs:label>Borderline-high total cholesterol (&gt;= 200 mg/dL)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasTotalCholesterol"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">200</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>Total cholesterol of 200-239 mg/dL is classed as borderline high.</hasExplanation>
    <hasAdvice>Ask for a full lipid profile (LDL, HDL, triglycerides) and review diet and activity.</hasAdvice>
    <hasSource>NCEP ATP III</hasSource>
    <hasSynonym>borderline total cholesterol</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#HighTotalCholesterolPatient">
    <rdfs:label>High total cholesterol (&gt;= 240 mg/dL)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#BorderlineHighTotalCholesterolPatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasTotalCholesterol"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">240</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>Total cholesterol of 240 mg/dL or more is classed as high.</hasExplanation>
    <hasAdvice>See a clinician to review your full lipid profile and overall risk.</hasAdvice>
    <hasSource>NCEP ATP III</hasSource>
    <hasSynonym>high total cholesterol</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#LowHDLPatient">
    <rdfs:label>Low HDL cholesterol (&lt; 40 mg/dL men, &lt; 50 mg/dL women)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Restriction><owl:onProperty rdf:resource="#hasSex"/><owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">male</owl:hasValue></owl:Restriction>
<owl:Restriction><owl:onProperty rdf:resource="#hasHDL"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">40</xsd:maxExclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Restriction><owl:onProperty rdf:resource="#hasSex"/><owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">female</owl:hasValue></owl:Restriction>
<owl:Restriction><owl:onProperty rdf:resource="#hasHDL"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50</xsd:maxExclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
</owl:unionOf></owl:Class>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>Low HDL ('good') cholesterol is linked to higher cardiovascular risk. The cut-off is lower for men than for women.</hasExplanation>
    <hasAdvice>Regular exercise, stopping smoking and a healthier diet can raise HDL; discuss with a clinician.</hasAdvice>
    <hasSource>NCEP ATP III; AHA/NHLBI metabolic syndrome statement (2005)</hasSource>
    <hasSynonym>low hdl</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#BorderlineHighTriglyceridePatient">
    <rdfs:label>Borderline-high triglycerides (&gt;= 150 mg/dL)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasTriglycerides"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">150</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>Triglycerides of 150-199 mg/dL are classed as borderline high.</hasExplanation>
    <hasAdvice>Reducing sugar, refined carbohydrates and alcohol, and losing excess weight, usually lowers triglycerides.</hasAdvice>
    <hasSource>NCEP ATP III</hasSource>
    <hasSynonym>borderline triglycerides</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#HighTriglyceridePatient">
    <rdfs:label>High triglycerides (&gt;= 200 mg/dL)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#BorderlineHighTriglyceridePatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasTriglycerides"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">200</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>Triglycerides of 200-499 mg/dL are classed as high.</hasExplanation>
    <hasAdvice>See a clinician to look for causes (for example diabetes) and plan treatment.</hasAdvice>
    <hasSource>NCEP ATP III</hasSource>
    <hasSynonym>high triglycerides</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#VeryHighTriglyceridePatient">
    <rdfs:label>Very high triglycerides (&gt;= 500 mg/dL)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#HighTriglyceridePatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasTriglycerides"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">500</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>lipids</hasCategory>
    <hasExplanation>Triglycerides of 500 mg/dL or more are classed as very high and can cause pancreatitis.</hasExplanation>
    <hasAdvice>See a clinician promptly; very high triglycerides usually need treatment.</hasAdvice>
    <hasSource>NCEP ATP III</hasSource>
    <hasSynonym>very high triglycerides</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Stage1OrHigherBPPatient">
    <rdfs:label>Blood pressure in stage 1 range or above (&gt;= 130 systolic or &gt;= 80 diastolic)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Restriction><owl:onProperty rdf:resource="#hasSystolicBP"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">130</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
<owl:Restriction><owl:onProperty rdf:resource="#hasDiastolicBP"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">80</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:unionOf></owl:Class>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>blood pressure</hasCategory>
    <hasExplanation>A reading of 130-139 systolic or 80-89 diastolic is stage 1 hypertension range. A diagnosis needs the average of readings on 2 or more occasions.</hasExplanation>
    <hasAdvice>Have your blood pressure re-measured properly (seated, rested, repeated on different days) and discuss lifestyle changes with a clinician.</hasAdvice>
    <hasSource>2017 ACC/AHA High Blood Pressure Guideline</hasSource>
    <hasSynonym>stage 1 hypertension</hasSynonym>
    <hasSynonym>stage 1 bp</hasSynonym>
    <hasSynonym>hypertension stage 1</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#Stage2HypertensionPatient">
    <rdfs:label>Stage 2 hypertension range (&gt;= 140 systolic or &gt;= 90 diastolic)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#Stage1OrHigherBPPatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Restriction><owl:onProperty rdf:resource="#hasSystolicBP"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">140</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
<owl:Restriction><owl:onProperty rdf:resource="#hasDiastolicBP"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">90</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:unionOf></owl:Class>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>blood pressure</hasCategory>
    <hasExplanation>A reading of 140/90 mmHg or higher is stage 2 hypertension range. A diagnosis needs the average of readings on 2 or more occasions.</hasExplanation>
    <hasAdvice>See a clinician soon to confirm the diagnosis and discuss treatment.</hasAdvice>
    <hasSource>2017 ACC/AHA High Blood Pressure Guideline</hasSource>
    <hasSynonym>stage 2 hypertension</hasSynonym>
    <hasSynonym>stage 2 bp</hasSynonym>
    <hasSynonym>hypertension stage 2</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#HypertensiveCrisisRangePatient">
    <rdfs:label>Hypertensive crisis range (&gt; 180 systolic or &gt; 120 diastolic)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#Stage2HypertensionPatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Restriction><owl:onProperty rdf:resource="#hasSystolicBP"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">180</xsd:minExclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
<owl:Restriction><owl:onProperty rdf:resource="#hasDiastolicBP"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">120</xsd:minExclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:unionOf></owl:Class>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>urgent</hasSeverity>
    <hasCategory>blood pressure</hasCategory>
    <hasExplanation>A reading above 180/120 mmHg is in the hypertensive crisis range.</hasExplanation>
    <hasAdvice>Re-measure after 5 minutes of rest. If it stays this high, or comes with chest pain, breathlessness, weakness, vision or speech changes, seek emergency care now.</hasAdvice>
    <hasSource>2017 ACC/AHA High Blood Pressure Guideline</hasSource>
    <hasSynonym>hypertensive crisis</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#ImpairedFastingGlucosePatient">
    <rdfs:label>Fasting glucose in prediabetes range (&gt;= 100 mg/dL)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasFastingGlucose"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>glucose</hasCategory>
    <hasExplanation>Fasting glucose of 100-125 mg/dL is the prediabetes range (rule assumes a fasting sample).</hasExplanation>
    <hasAdvice>Ask a clinician about diabetes screening; weight loss and exercise can prevent progression.</hasAdvice>
    <hasSource>ADA Standards of Care in Diabetes</hasSource>
    <hasSynonym>prediabetes</hasSynonym>
    <hasSynonym>impaired fasting glucose</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#DiabetesRangeFastingGlucosePatient">
    <rdfs:label>Fasting glucose in diabetes range (&gt;= 126 mg/dL)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#ImpairedFastingGlucosePatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasFastingGlucose"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">126</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>glucose</hasCategory>
    <hasExplanation>Fasting glucose of 126 mg/dL or more is in the diabetes range. This is not a diagnosis: it needs confirmation by repeat testing.</hasExplanation>
    <hasAdvice>See a clinician to confirm with a repeat test and discuss next steps.</hasAdvice>
    <hasSource>ADA Standards of Care in Diabetes</hasSource>
    <hasSynonym>diabetes range glucose</hasSynonym>
    <hasSynonym>diabetes</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#PrediabetesRangeHbA1cPatient">
    <rdfs:label>HbA1c in prediabetes range (&gt;= 5.7 %)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasHbA1c"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.7</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>glucose</hasCategory>
    <hasExplanation>HbA1c of 5.7-6.4 % is the prediabetes range.</hasExplanation>
    <hasAdvice>Ask a clinician about diabetes screening and lifestyle prevention programmes.</hasAdvice>
    <hasSource>ADA Standards of Care in Diabetes</hasSource>
    <hasSynonym>prediabetes hba1c</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#DiabetesRangeHbA1cPatient">
    <rdfs:label>HbA1c in diabetes range (&gt;= 6.5 %)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#PrediabetesRangeHbA1cPatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasHbA1c"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.5</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>glucose</hasCategory>
    <hasExplanation>HbA1c of 6.5 % or more is in the diabetes range. This is not a diagnosis: it needs confirmation by repeat testing.</hasExplanation>
    <hasAdvice>See a clinician to confirm with a repeat test and discuss next steps.</hasAdvice>
    <hasSource>ADA Standards of Care in Diabetes</hasSource>
    <hasSynonym>diabetes range hba1c</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#OverweightPatient">
    <rdfs:label>Overweight (BMI &gt;= 25)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasBMI"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>weight</hasCategory>
    <hasExplanation>BMI of 25-29.9 is classed as overweight. For South Asian populations the WHO expert consultation suggests lower action points (about 23 and 27.5), so the risk may be higher than this label suggests.</hasExplanation>
    <hasAdvice>Gradual weight loss through diet and activity improves blood pressure, glucose and lipids.</hasAdvice>
    <hasSource>WHO BMI classification; WHO Expert Consultation (Lancet, 2004)</hasSource>
    <hasSynonym>overweight</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#ObesePatient">
    <rdfs:label>Obesity (BMI &gt;= 30)</rdfs:label>
    <rdfs:subClassOf rdf:resource="#OverweightPatient"/>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasBMI"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>weight</hasCategory>
    <hasExplanation>BMI of 30 or more is classed as obesity. For South Asian populations the WHO expert consultation suggests lower action points (about 23 and 27.5).</hasExplanation>
    <hasAdvice>Discuss a weight-management plan with a clinician or dietitian.</hasAdvice>
    <hasSource>WHO BMI classification; WHO Expert Consultation (Lancet, 2004)</hasSource>
    <hasSynonym>obesity</hasSynonym>
    <hasSynonym>obese</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#SmokerPatient">
    <rdfs:label>Current smoker</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#isSmoker"/><owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>lifestyle</hasCategory>
    <hasExplanation>Smoking damages blood vessels and raises the risk of heart attack and stroke, and it adds to the effect of other risk factors.</hasExplanation>
    <hasAdvice>Quitting is one of the most effective ways to lower cardiovascular risk. Ask a clinician or pharmacist about cessation support.</hasAdvice>
    <hasSource>2019 ACC/AHA Primary Prevention Guideline</hasSource>
    <hasSynonym>current smoker</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#FamilyHistoryPrematureCVDPatient">
    <rdfs:label>Family history of premature heart disease</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasFamilyHistoryPrematureCVD"/><owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>moderate</hasSeverity>
    <hasCategory>history</hasCategory>
    <hasExplanation>Heart disease in a close relative at a young age (father or brother before 55, mother or sister before 65) raises your own risk.</hasExplanation>
    <hasAdvice>Tell your clinician about your family history; it can change how early screening and treatment are considered.</hasAdvice>
    <hasSource>2019 ACC/AHA Primary Prevention Guideline</hasSource>
    <hasSynonym>premature family history</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#AgeRiskFactorPatient">
    <rdfs:label>Age risk factor (men &gt;= 45, women &gt;= 55)</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Restriction><owl:onProperty rdf:resource="#hasSex"/><owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">male</owl:hasValue></owl:Restriction>
<owl:Restriction><owl:onProperty rdf:resource="#hasAge"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Restriction><owl:onProperty rdf:resource="#hasSex"/><owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">female</owl:hasValue></owl:Restriction>
<owl:Restriction><owl:onProperty rdf:resource="#hasAge"/><owl:someValuesFrom><rdfs:Datatype><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55</xsd:minInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype></owl:someValuesFrom></owl:Restriction>
</owl:intersectionOf></owl:Class>
</owl:unionOf></owl:Class>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>info</hasSeverity>
    <hasCategory>age</hasCategory>
    <hasExplanation>Age 45 or older in men and 55 or older in women is counted as a cardiovascular risk factor. It cannot be changed, so it makes the other factors more important to control.</hasExplanation>
    <hasAdvice>Keep regular check-ups of blood pressure, lipids and glucose.</hasAdvice>
    <hasSource>NCEP ATP III</hasSource>
    <hasSynonym>age risk factor</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#ChestPainAlertPatient">
    <rdfs:label>Chest pain reported</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Patient"/>
<owl:Restriction><owl:onProperty rdf:resource="#hasChestPain"/><owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue></owl:Restriction>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>urgent</hasSeverity>
    <hasCategory>symptom</hasCategory>
    <hasExplanation>Chest pain can be a sign of a heart attack. A chatbot cannot tell the cause and cannot examine you.</hasExplanation>
    <hasAdvice>If the pain is happening now, is severe, spreads to the arm, jaw or back, or comes with breathlessness, sweating or fainting: call your local emergency number or go to the nearest emergency department immediately. Do not wait for a lab report.</hasAdvice>
    <hasSource>2021 AHA/ACC Chest Pain Guideline</hasSource>
    <hasSynonym>chest pain alert</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#HypertensionWithDiabetesRangePatient">
    <rdfs:label>High blood pressure together with diabetes-range glucose</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#Stage1OrHigherBPPatient"/>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Class rdf:about="#DiabetesRangeFastingGlucosePatient"/>
<owl:Class rdf:about="#DiabetesRangeHbA1cPatient"/>
</owl:unionOf></owl:Class>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>combined</hasCategory>
    <hasExplanation>High blood pressure and diabetes-range glucose both damage blood vessels, and together they raise cardiovascular risk more than either alone.</hasExplanation>
    <hasAdvice>Ask a clinician to review both; treating them together matters.</hasAdvice>
    <hasSource>2017 ACC/AHA High Blood Pressure Guideline; ADA Standards of Care in Diabetes</hasSource>
    <hasSynonym>hypertension with diabetes</hasSynonym>
    <hasSynonym>diabetes and high blood pressure</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#SmokerWithAtherogenicLipidsPatient">
    <rdfs:label>Smoking together with high LDL or low HDL</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:intersectionOf rdf:parseType="Collection">
<owl:Class rdf:about="#SmokerPatient"/>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Class rdf:about="#HighLDLPatient"/>
<owl:Class rdf:about="#LowHDLPatient"/>
</owl:unionOf></owl:Class>
</owl:intersectionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>combined</hasCategory>
    <hasExplanation>Smoking together with high LDL or low HDL compounds the damage to artery walls.</hasExplanation>
    <hasAdvice>Stopping smoking is the single most useful step here; ask a clinician about support and lipid treatment.</hasAdvice>
    <hasSource>2019 ACC/AHA Primary Prevention Guideline; NCEP ATP III</hasSource>
    <hasSynonym>smoker with bad lipids</hasSynonym>
  </owl:Class>

  <owl:Class rdf:about="#UrgentAttentionPatient">
    <rdfs:label>Needs urgent medical attention</rdfs:label>
    <rdfs:subClassOf rdf:resource="#ClinicianReviewPatient"/>
    <owl:equivalentClass>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Class rdf:about="#ChestPainAlertPatient"/>
<owl:Class rdf:about="#HypertensiveCrisisRangePatient"/>
</owl:unionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>urgent</hasSeverity>
    <hasCategory>summary</hasCategory>
    <hasExplanation>At least one finding needs urgent medical attention.</hasExplanation>
    <hasAdvice>Seek medical care now rather than continuing with this chat.</hasAdvice>
    <hasSource>Derived from the individual findings</hasSource>
  </owl:Class>

  <owl:Class rdf:about="#ClinicianReviewPatient">
    <rdfs:label>Worth reviewing with a clinician</rdfs:label>
    <owl:equivalentClass>
<owl:Class><owl:unionOf rdf:parseType="Collection">
<owl:Class rdf:about="#UrgentAttentionPatient"/>
<owl:Class rdf:about="#Stage2HypertensionPatient"/>
<owl:Class rdf:about="#HighLDLPatient"/>
<owl:Class rdf:about="#HighTotalCholesterolPatient"/>
<owl:Class rdf:about="#HighTriglyceridePatient"/>
<owl:Class rdf:about="#DiabetesRangeFastingGlucosePatient"/>
<owl:Class rdf:about="#DiabetesRangeHbA1cPatient"/>
<owl:Class rdf:about="#SmokerWithAtherogenicLipidsPatient"/>
<owl:Class rdf:about="#HypertensionWithDiabetesRangePatient"/>
</owl:unionOf></owl:Class>
    </owl:equivalentClass>
    <hasSeverity>high</hasSeverity>
    <hasCategory>summary</hasCategory>
    <hasExplanation>One or more findings are in a range where guidelines recommend professional follow-up.</hasExplanation>
    <hasAdvice>Book an appointment with a doctor to review these results.</hasAdvice>
    <hasSource>Derived from the individual findings</hasSource>
  </owl:Class>

